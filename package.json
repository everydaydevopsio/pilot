{
  "name": "ai-agent-browser",
  "version": "0.1.0",
  "description": "DevTools-grade browser control service for AI agents via WebSocket + CDP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aab": "dist/index.js",
    "aab-mcp": "dist/mcp/index.js",
    "ai-agent-browser": "dist/index.js",
    "ai-agent-browser-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e",
    "prepare": "husky"
  },
  "keywords": [
    "browser",
    "cdp",
    "ai-agent",
    "websocket",
    "chrome"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrome-remote-interface": "^0.34.0",
    "fastify": "^5.8.2",
    "pino": "^10.3.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.ts": [
      "tsc-files --noEmit",
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.4.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.3.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "tsc-files": "^1.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
